npc_id = "sunny"
display_name = "Sunny"
lines = PackedStringArray("Duuude. Feel that sun? Totally radical.", "I'm Sunny. Yeah, like the beach. My parents had one idea and they ran with it.", "If you ever wanna learn to surf, come back tomorrow. I say that every day.")
repeat_lines = PackedStringArray("Waves are lookin' gnarly today. Gnarly means good. I think.")
