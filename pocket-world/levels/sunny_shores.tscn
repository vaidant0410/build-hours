display_name = "Keeper Wren"
lines = PackedStringArray("Welcome to my lighthouse! Every night I light the lamp so the boats find their way home.", "From the top you can almost see Frosty Peaks. Almost. I squint a lot.", "Hundred and twelve steps to the top. I counted. Then I counted again and got a hundred and fourteen.")
