transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0.75, 26.75)
npc_id = "captain_coral"
display_name = "Captain Coral"
lines = PackedStringArray("Ahoy, landlubber! Welcome to Sunny Shores!", "Captain Coral's the name. This dock is my ship. It doesn't float, but it's never sunk either.", "Old Tomo still going on about Gerald? Gerald is a SEA fish. I'd know. He's my cousin's fish.")
repeat_lines = PackedStringArray("Fair winds, matey! Or at least, mild breezes.")
