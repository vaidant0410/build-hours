transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 27, 3.65, -22)
npc_id = "moss"
display_name = "Moss"
lines = PackedStringArray("Mushrooms! Mushrooms everywhere! Isn't it wonderful?", "I'm Moss. I've named every single mushroom in these woods.", "That big one's Kevin. The blue one is also Kevin. I ran out of names.")
repeat_lines = PackedStringArray("Kevin says hi. Both Kevins.")
