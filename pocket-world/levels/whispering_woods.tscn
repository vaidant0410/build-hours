[node name="Hazel" parent="NPCs" instance=ExtResource("27_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4, 3.15, -3)
npc_id = "hazel"
display_name = "Ranger Hazel"
lines = PackedStringArray("Shh... listen. Hear that? That's the woods whispering.", "I'm Hazel, the ranger. I look after everything that grows out here.", "If you find the giant mushrooms, please don't poke them. They sneeze.", "And watch the stream. The bridge is safe. The stepping stones are... optimistic.")
repeat_lines = PackedStringArray("The trees say hello. Well, they rustle. I choose to hear hello.")
wander_radius = 2
skin_color = Color(0.96, 0.74, 0.56, 1)
