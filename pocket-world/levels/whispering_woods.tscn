transform = Transform3D(0.7926, 0, 0.6097, 0, 1, 0, -0.6097, 0, 0.7926, 5.2, 3.15, 4.6)
npc_id = "bramble"
display_name = "Bramble"
lines = PackedStringArray("Mmm, nothing beats a campfire. Pull up a log.", "I'm Bramble. I tell stories. Want one? Once upon a time, there was a bear who wanted to be a baker...", "...he asked Pip for a job, and Pip said no. The end.", "It's a sad story. I'm working on a sequel.")
