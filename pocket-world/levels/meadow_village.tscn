display_name = "Pip the Baker"
lines = PackedStringArray("Fresh buns! Well... not THAT kind of Bun. The Mayor gets touchy about it.", "I'm Pip. I bake for the whole valley.", "If you're heading up to Frosty Peaks, Professor Frost still owes me for three blueberry pies.")
repeat_lines = PackedStringArray("Try the cinnamon swirl. It swirls.")
