transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 2.65, 7)
npc_id = "mayor_bun"
display_name = "Mayor Bun"
lines = PackedStringArray("Oh! A new face in Meadow Village! Welcome, welcome!", "I'm Mayor Bun. I keep the flowers watered and the gossip flowing.", "Our village sits right in the middle of everything. Hop through the glowing rings to visit the Woods, the Shores or the Peaks.", "Make friends wherever you go! A town is only as cosy as its neighbours.")
repeat_lines = PackedStringArray("Met anyone new lately? Everyone around here has a story, you know.")
wander_radius = 2.5
